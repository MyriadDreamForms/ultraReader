@using UltraReader.Services
@using UltraReader.Services.DTOs
@implements IAsyncDisposable
@inject IChapterService ChapterService
@inject IPageService PageService
@inject IImageService ImageService
@inject IJSRuntime JS

<div class="full-series-import">
    <div class="import-header">
        <h4>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                <line x1="12" y1="11" x2="12" y2="17"></line>
                <line x1="9" y1="14" x2="15" y2="14"></line>
            </svg>
            Tüm Seriyi İçe Aktar
        </h4>
    </div>

    @if (importState == ImportState.Completed)
    {
        <div class="import-success">
            <div class="success-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h3>İçe Aktarma Tamamlandı!</h3>
            <p>@importedChapterCount bölüm, @importedPageCount sayfa başarıyla eklendi.</p>
            <button type="button" class="btn btn-outline btn-sm" style="margin-top: 1rem;" @onclick="Reset">
                Başka Seri Ekle
            </button>
        </div>
    }
    else if (importState == ImportState.Error)
    {
        <div class="import-error">
            <p>@errorMessage</p>
            <button type="button" class="btn btn-outline btn-sm" @onclick="Reset">Tekrar Dene</button>
        </div>
    }
    else if (importState == ImportState.Importing)
    {
        <div class="import-progress">
            <div class="progress-spinner">
                <div class="loading-spinner"></div>
            </div>
            <div class="progress-info">
                <p class="progress-title">İçe aktarılıyor...</p>
                <p class="progress-detail">Bölüm @currentChapterIndex / @totalChapterCount</p>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @progressPercent%"></div>
                </div>
                <p class="progress-status">@currentStatus</p>
            </div>
        </div>
    }
    else if (importState == ImportState.Pending && pendingChapters.Count > 0)
    {
        <div class="pending-info">
            <div class="pending-stats">
                <div class="stat-item">
                    <span class="stat-value">@pendingChapters.Count</span>
                    <span class="stat-label">Bölüm</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">@pendingChapters.Sum(c => c.FileInfos.Count)</span>
                    <span class="stat-label">Sayfa</span>
                </div>
            </div>
            <div class="pending-preview">
                @foreach (var chapter in pendingChapters.Take(5))
                {
                    <div class="chapter-mini-preview">
                        <span class="chapter-badge">@chapter.FolderName</span>
                        <span class="page-count">@chapter.FileInfos.Count sayfa</span>
                    </div>
                }
                @if (pendingChapters.Count > 5)
                {
                    <div class="more-chapters">
                        +@(pendingChapters.Count - 5) bölüm daha
                    </div>
                }
            </div>
            <div class="pending-actions">
                <button type="button" class="btn btn-outline" @onclick="Reset">İptal</button>
                <button type="button" class="btn btn-primary" @onclick="StartImport" disabled="@(!SeriesId.HasValue)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Tümünü İçe Aktar
                </button>
            </div>
        </div>
    }
    else if (importState == ImportState.Loading)
    {
        <div class="import-progress">
            <div class="progress-spinner">
                <div class="loading-spinner"></div>
            </div>
            <div class="progress-info">
                <p class="progress-title">Klasör seçiliyor...</p>
                <p class="progress-status">Lütfen bekleyin</p>
            </div>
        </div>
    }
    else
    {
        <div class="import-zone" @onclick="SelectFolder">
            <div class="import-zone-label">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    <line x1="12" y1="11" x2="12" y2="17"></line>
                    <line x1="9" y1="14" x2="15" y2="14"></line>
                </svg>
                <span class="import-zone-title">Seri Klasörünü Seçin</span>
                <span class="import-zone-hint">Her alt klasör bir bölüm olarak oluşturulur</span>
            </div>
        </div>
    }
</div>

<style>
    .full-series-import {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.25rem;
        margin-top: 1.5rem;
    }

    .import-header {
        margin-bottom: 1rem;
    }

    .import-header h4 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 1rem;
        color: var(--text-primary);
    }

    .import-zone {
        border: 2px dashed var(--border-color);
        border-radius: 10px;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .import-zone:hover {
        border-color: var(--primary);
        background: rgba(99, 102, 241, 0.05);
    }

    .import-zone-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        text-align: center;
        color: var(--text-secondary);
    }

    .import-zone-label svg {
        margin-bottom: 0.75rem;
        opacity: 0.6;
    }

    .import-zone:hover .import-zone-label svg {
        opacity: 1;
        color: var(--primary);
    }

    .import-zone-title {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
    }

    .import-zone-hint {
        font-size: 0.8rem;
        opacity: 0.7;
    }

    /* Pending State */
    .pending-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pending-stats {
        display: flex;
        gap: 2rem;
        justify-content: center;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary);
    }

    .stat-label {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .pending-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
    }

    .chapter-mini-preview {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        background: var(--bg-secondary);
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .chapter-badge {
        font-weight: 600;
        color: var(--primary);
    }

    .page-count {
        color: var(--text-secondary);
    }

    .more-chapters {
        padding: 0.35rem 0.75rem;
        background: var(--bg-secondary);
        border-radius: 6px;
        font-size: 0.8rem;
        color: var(--text-muted);
        font-style: italic;
    }

    .pending-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
    }

    /* Progress State */
    .import-progress {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
    }

    .progress-spinner {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .progress-info {
        text-align: center;
        width: 100%;
    }

    .progress-title {
        font-weight: 600;
        margin: 0 0 0.25rem 0;
    }

    .progress-detail {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin: 0 0 0.75rem 0;
    }

    .progress-bar {
        height: 6px;
        background: var(--bg-secondary);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .progress-fill {
        height: 100%;
        background: var(--primary);
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    .progress-status {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin: 0;
    }

    /* Success State */
    .import-success {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem 1rem;
        text-align: center;
    }

    .success-icon {
        color: #22c55e;
        margin-bottom: 0.75rem;
    }

    .import-success h3 {
        margin: 0 0 0.5rem 0;
        color: #22c55e;
    }

    .import-success p {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Error State */
    .import-error {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: rgba(239, 68, 68, 0.1);
        border-radius: 8px;
    }

    .import-error p {
        margin: 0;
        color: #ef4444;
        text-align: center;
    }
</style>

@code {
    [Parameter]
    public int? SeriesId { get; set; }

    [Parameter]
    public EventCallback<int> OnImportComplete { get; set; }

    private enum ImportState { Idle, Loading, Pending, Importing, Completed, Error }
    private ImportState importState = ImportState.Idle;

    private string pickerId = Guid.NewGuid().ToString("N");
    private List<PendingChapter> pendingChapters = [];
    private int importedChapterCount = 0;
    private int importedPageCount = 0;
    private int totalChapterCount = 0;
    private int currentChapterIndex = 0;
    private int progressPercent = 0;
    private string currentStatus = "";
    private string? errorMessage;

    private async Task SelectFolder()
    {
        importState = ImportState.Loading;
        StateHasChanged();

        try
        {
            // JS ile klasör seç ve bilgileri al
            var folderInfo = await JS.InvokeAsync<FolderInfo>("filePickerInterop.openFolderPicker", pickerId, null);
            
            if (folderInfo == null || folderInfo.Files == null || folderInfo.Files.Length == 0)
            {
                importState = ImportState.Idle;
                StateHasChanged();
                return;
            }

            pendingChapters.Clear();

            // Dosyaları alt klasörlere göre grupla
            var filesBySubfolder = new Dictionary<string, List<FileInfoJs>>();

            foreach (var file in folderInfo.Files)
            {
                if (string.IsNullOrEmpty(file.Type) || !file.Type.StartsWith("image/"))
                    continue;

                var pathParts = file.Path.Split('/');
                
                string subfolderName;
                
                if (pathParts.Length >= 3)
                {
                    subfolderName = pathParts[1];
                }
                else if (pathParts.Length == 2)
                {
                    subfolderName = "1";
                }
                else
                {
                    continue;
                }

                if (!filesBySubfolder.ContainsKey(subfolderName))
                    filesBySubfolder[subfolderName] = [];

                filesBySubfolder[subfolderName].Add(file);
            }

            // Her alt klasör için bir bölüm oluştur
            foreach (var kvp in filesBySubfolder.OrderBy(f => ExtractNumber(f.Key)))
            {
                var chapterNumber = ExtractNumber(kvp.Key);

                var sortedFiles = kvp.Value
                    .OrderBy(f => ExtractNumber(f.Name))
                    .ThenBy(f => f.Name, Comparer<string>.Create(NaturalCompare))
                    .ToList();

                var pendingChapter = new PendingChapter
                {
                    ChapterNumber = chapterNumber,
                    FolderName = kvp.Key,
                    FileInfos = sortedFiles
                };

                pendingChapters.Add(pendingChapter);
            }

            importState = pendingChapters.Count > 0 ? ImportState.Pending : ImportState.Idle;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Klasör okunurken hata: {ex.Message}";
            importState = ImportState.Error;
            StateHasChanged();
        }
    }

    private async Task StartImport()
    {
        if (!SeriesId.HasValue || pendingChapters.Count == 0) return;

        importState = ImportState.Importing;
        importedChapterCount = 0;
        importedPageCount = 0;
        totalChapterCount = pendingChapters.Count;
        currentChapterIndex = 0;
        progressPercent = 0;
        currentStatus = "Başlatılıyor...";
        StateHasChanged();

        try
        {
            var existingChapters = await ChapterService.GetChaptersAsync(SeriesId.Value);
            var existingNums = existingChapters.Select(c => c.Number).ToHashSet();

            foreach (var chapter in pendingChapters.OrderBy(c => c.ChapterNumber))
            {
                currentChapterIndex++;
                progressPercent = (int)((double)currentChapterIndex / totalChapterCount * 100);
                
                var chapterNumber = chapter.ChapterNumber;
                while (existingNums.Contains(chapterNumber))
                {
                    chapterNumber++;
                }
                existingNums.Add(chapterNumber);

                currentStatus = $"Bölüm {chapterNumber} oluşturuluyor...";
                StateHasChanged();
                await Task.Delay(1); // UI güncellemesi için

                var createCommand = new CreateChapterCommand
                {
                    Number = chapterNumber,
                    Title = null
                };
                var newChapterId = await ChapterService.CreateChapterAsync(SeriesId.Value, createCommand);

                int pageOrder = 0;
                foreach (var fileInfo in chapter.FileInfos)
                {
                    pageOrder++;
                    currentStatus = $"Bölüm {chapterNumber}: Sayfa {pageOrder}/{chapter.FileInfos.Count}";
                    StateHasChanged();

                    try
                    {
                        var base64Data = await JS.InvokeAsync<string>("filePickerInterop.readFileAsBase64", pickerId, fileInfo.Index);
                        
                        if (string.IsNullOrEmpty(base64Data))
                            continue;

                        var base64Content = base64Data.Contains(',') 
                            ? base64Data.Substring(base64Data.IndexOf(',') + 1) 
                            : base64Data;
                        var imageData = Convert.FromBase64String(base64Content);

                        using var ms = new MemoryStream(imageData);
                        var savedPath = await ImageService.SavePageImageAsync(ms, fileInfo.Name, newChapterId);

                        var pageCommand = new AddPageCommand
                        {
                            PageNumber = pageOrder,
                            ImagePath = savedPath
                        };
                        await PageService.AddPageAsync(newChapterId, pageCommand);
                        importedPageCount++;
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error importing page {fileInfo.Name}: {ex.Message}");
                    }
                }

                importedChapterCount++;
            }

            importState = ImportState.Completed;
            pendingChapters.Clear();

            if (OnImportComplete.HasDelegate)
                await OnImportComplete.InvokeAsync(importedChapterCount);
        }
        catch (Exception ex)
        {
            errorMessage = $"İçe aktarma hatası: {ex.Message}";
            importState = ImportState.Error;
        }
        
        StateHasChanged();
    }

    private async Task Reset()
    {
        await JS.InvokeVoidAsync("filePickerInterop.disposeFolderPicker", pickerId);
        
        importState = ImportState.Idle;
        pendingChapters.Clear();
        errorMessage = null;
        importedChapterCount = 0;
        importedPageCount = 0;
        pickerId = Guid.NewGuid().ToString("N");
    }

    private static decimal ExtractNumber(string input)
    {
        var match = System.Text.RegularExpressions.Regex.Match(input, @"(\d+(?:\.\d+)?)");
        if (match.Success && decimal.TryParse(match.Value, System.Globalization.NumberStyles.Any, 
            System.Globalization.CultureInfo.InvariantCulture, out var num))
            return num;
        return 1;
    }

    private static int NaturalCompare(string a, string b)
    {
        int ia = 0, ib = 0;
        while (ia < a.Length && ib < b.Length)
        {
            if (char.IsDigit(a[ia]) && char.IsDigit(b[ib]))
            {
                int numStartA = ia, numStartB = ib;
                while (ia < a.Length && char.IsDigit(a[ia])) ia++;
                while (ib < b.Length && char.IsDigit(b[ib])) ib++;
                
                var numA = long.Parse(a.Substring(numStartA, ia - numStartA));
                var numB = long.Parse(b.Substring(numStartB, ib - numStartB));
                
                if (numA != numB) return numA.CompareTo(numB);
            }
            else
            {
                if (a[ia] != b[ib]) return a[ia].CompareTo(b[ib]);
                ia++; ib++;
            }
        }
        return a.Length.CompareTo(b.Length);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("filePickerInterop.disposeFolderPicker", pickerId);
        }
        catch { }
    }

    private class FolderInfo
    {
        public string FolderName { get; set; } = string.Empty;
        public FileInfoJs[] Files { get; set; } = [];
    }

    private class FileInfoJs
    {
        public string Name { get; set; } = string.Empty;
        public string Path { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public long Size { get; set; }
        public int Index { get; set; }
    }

    private class PendingChapter
    {
        public decimal ChapterNumber { get; set; }
        public string FolderName { get; set; } = string.Empty;
        public List<FileInfoJs> FileInfos { get; set; } = [];
    }
}
