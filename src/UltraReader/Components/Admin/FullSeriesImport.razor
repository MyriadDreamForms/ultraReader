@using UltraReader.Services
@using UltraReader.Services.DTOs
@inject IChapterService ChapterService
@inject IPageService PageService
@inject IImageService ImageService
@inject IJSRuntime JS

<div class="full-series-import">
    <div class="import-header">
        <h4>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                <line x1="12" y1="11" x2="12" y2="17"></line>
                <line x1="9" y1="14" x2="15" y2="14"></line>
            </svg>
            Tüm Seriyi İçe Aktar
        </h4>
    </div>

    @if (importState == ImportState.Completed)
    {
        <div class="import-success">
            <div class="success-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h3>İçe Aktarma Tamamlandı!</h3>
            <p>@importedChapterCount bölüm, @importedPageCount sayfa başarıyla eklendi.</p>
        </div>
    }
    else if (importState == ImportState.Error)
    {
        <div class="import-error">
            <p>@errorMessage</p>
            <button type="button" class="btn btn-outline btn-sm" @onclick="Reset">Tekrar Dene</button>
        </div>
    }
    else if (importState == ImportState.Importing)
    {
        <div class="import-progress">
            <div class="progress-spinner">
                <div class="loading-spinner"></div>
            </div>
            <div class="progress-info">
                <p class="progress-title">İçe aktarılıyor...</p>
                <p class="progress-detail">Bölüm @currentChapterNum / @totalChapterCount</p>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(totalChapterCount > 0 ? (int)((double)importedChapterCount / totalChapterCount * 100) : 0)%"></div>
                </div>
                <p class="progress-status">@currentStatus</p>
            </div>
        </div>
    }
    else if (importState == ImportState.Pending && pendingChapters.Count > 0)
    {
        <div class="pending-info">
            <div class="pending-stats">
                <div class="stat-item">
                    <span class="stat-value">@pendingChapters.Count</span>
                    <span class="stat-label">Bölüm</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">@pendingChapters.Sum(c => c.Pages.Count)</span>
                    <span class="stat-label">Sayfa</span>
                </div>
            </div>
            <div class="pending-preview">
                @foreach (var chapter in pendingChapters.Take(5))
                {
                    <div class="chapter-mini-preview">
                        <span class="chapter-badge">@chapter.ChapterNumber</span>
                        <span class="page-count">@chapter.Pages.Count sayfa</span>
                    </div>
                }
                @if (pendingChapters.Count > 5)
                {
                    <div class="more-chapters">
                        +@(pendingChapters.Count - 5) bölüm daha
                    </div>
                }
            </div>
            <button type="button" class="btn btn-primary" @onclick="StartImport" disabled="@(!SeriesId.HasValue)">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Tümünü İçe Aktar
            </button>
        </div>
    }
    else
    {
        <div class="import-zone">
            <InputFile OnChange="OnFilesSelected" multiple accept="image/*" webkitdirectory directory class="input-file-hidden" id="fullSeriesInput" />
            <label for="fullSeriesInput" class="import-zone-label">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    <line x1="12" y1="11" x2="12" y2="17"></line>
                    <line x1="9" y1="14" x2="15" y2="14"></line>
                </svg>
                <span class="import-zone-title">Seri Klasörünü Seçin</span>
                <span class="import-zone-hint">Her alt klasör bir bölüm olarak oluşturulur</span>
            </label>
        </div>
    }
</div>

<style>
    .full-series-import {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.25rem;
        margin-top: 1.5rem;
    }

    .import-header {
        margin-bottom: 1rem;
    }

    .import-header h4 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 1rem;
        color: var(--text-primary);
    }

    .import-zone {
        border: 2px dashed var(--border-color);
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .import-zone:hover {
        border-color: var(--primary);
        background: rgba(99, 102, 241, 0.05);
    }

    .import-zone-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        cursor: pointer;
        text-align: center;
        color: var(--text-secondary);
    }

    .import-zone-label svg {
        margin-bottom: 0.75rem;
        opacity: 0.6;
    }

    .import-zone:hover .import-zone-label svg {
        opacity: 1;
        color: var(--primary);
    }

    .import-zone-title {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
    }

    .import-zone-hint {
        font-size: 0.8rem;
        opacity: 0.7;
    }

    .input-file-hidden {
        display: none;
    }

    /* Pending State */
    .pending-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pending-stats {
        display: flex;
        gap: 2rem;
        justify-content: center;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary);
    }

    .stat-label {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .pending-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
    }

    .chapter-mini-preview {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.75rem;
        background: var(--bg-secondary);
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .chapter-badge {
        font-weight: 600;
        color: var(--primary);
    }

    .page-count {
        color: var(--text-secondary);
    }

    .more-chapters {
        padding: 0.35rem 0.75rem;
        background: var(--bg-secondary);
        border-radius: 6px;
        font-size: 0.8rem;
        color: var(--text-muted);
        font-style: italic;
    }

    .pending-info .btn {
        align-self: center;
    }

    /* Progress State */
    .import-progress {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
    }

    .progress-spinner {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .progress-info {
        text-align: center;
        width: 100%;
    }

    .progress-title {
        font-weight: 600;
        margin: 0 0 0.25rem 0;
    }

    .progress-detail {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin: 0 0 0.75rem 0;
    }

    .progress-bar {
        height: 6px;
        background: var(--bg-secondary);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .progress-fill {
        height: 100%;
        background: var(--primary);
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    .progress-status {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin: 0;
    }

    /* Success State */
    .import-success {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem 1rem;
        text-align: center;
    }

    .success-icon {
        color: #22c55e;
        margin-bottom: 0.75rem;
    }

    .import-success h3 {
        margin: 0 0 0.5rem 0;
        color: #22c55e;
    }

    .import-success p {
        margin: 0;
        color: var(--text-secondary);
    }

    /* Error State */
    .import-error {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: rgba(239, 68, 68, 0.1);
        border-radius: 8px;
    }

    .import-error p {
        margin: 0;
        color: #ef4444;
        text-align: center;
    }
</style>

@code {
    [Parameter]
    public int? SeriesId { get; set; }

    [Parameter]
    public EventCallback<int> OnImportComplete { get; set; }

    private enum ImportState { Idle, Pending, Importing, Completed, Error }
    private ImportState importState = ImportState.Idle;

    private List<PendingChapter> pendingChapters = [];
    private int importedChapterCount = 0;
    private int importedPageCount = 0;
    private int totalChapterCount = 0;
    private decimal currentChapterNum = 0;
    private string currentStatus = "";
    private string? errorMessage;

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        pendingChapters.Clear();
        errorMessage = null;

        try
        {
            var files = e.GetMultipleFiles(5000);
            
            // Dosyaları klasör yapısına göre grupla
            var filesByFolder = new Dictionary<string, List<(string fileName, int pageNum, IBrowserFile file)>>();

            foreach (var file in files)
            {
                if (!file.ContentType.StartsWith("image/")) continue;

                var fullPath = file.Name;
                var parts = fullPath.Replace('\\', '/').Split('/');
                
                string folderName;
                string fileName;

                if (parts.Length >= 2)
                {
                    // Klasör yapısı var: "Chapter 1/001.jpg" veya "1/page001.jpg"
                    folderName = parts[^2]; // Son önceki klasör
                    fileName = parts[^1];   // Dosya adı
                }
                else
                {
                    // Düz dosya: "1_001.jpg" formatı
                    var match = System.Text.RegularExpressions.Regex.Match(fullPath, @"^(\d+(?:\.\d+)?)_");
                    if (match.Success)
                    {
                        folderName = match.Groups[1].Value;
                        fileName = fullPath;
                    }
                    else
                    {
                        folderName = "1";
                        fileName = fullPath;
                    }
                }

                // Sayfa numarasını çıkar
                var pageMatch = System.Text.RegularExpressions.Regex.Match(fileName, @"(\d+)");
                var pageNum = pageMatch.Success ? int.Parse(pageMatch.Value) : 0;

                if (!filesByFolder.ContainsKey(folderName))
                    filesByFolder[folderName] = [];

                filesByFolder[folderName].Add((fileName, pageNum, file));
            }

            // Her klasör için bir bölüm oluştur
            foreach (var folder in filesByFolder.OrderBy(f => ExtractNumber(f.Key)))
            {
                var chapterNumber = ExtractNumber(folder.Key);

                var pendingChapter = new PendingChapter
                {
                    ChapterNumber = chapterNumber,
                    FolderName = folder.Key
                };

                // Dosyaları sırala
                var sortedFiles = folder.Value
                    .OrderBy(f => f.pageNum)
                    .ThenBy(f => f.fileName, Comparer<string>.Create(NaturalCompare))
                    .ToList();

                int pageOrder = 0;
                foreach (var (fileName, _, file) in sortedFiles)
                {
                    try
                    {
                        using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
                        using var ms = new MemoryStream();
                        await stream.CopyToAsync(ms);
                        var data = ms.ToArray();

                        pageOrder++;
                        pendingChapter.Pages.Add(new PendingPage
                        {
                            Order = pageOrder,
                            FileName = fileName,
                            Data = data,
                            ContentType = file.ContentType
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading {fileName}: {ex.Message}");
                    }
                }

                if (pendingChapter.Pages.Count > 0)
                    pendingChapters.Add(pendingChapter);
            }

            if (pendingChapters.Count > 0)
                importState = ImportState.Pending;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Dosyalar yüklenirken hata: {ex.Message}";
            importState = ImportState.Error;
        }
    }

    private async Task StartImport()
    {
        if (!SeriesId.HasValue || pendingChapters.Count == 0) return;

        importState = ImportState.Importing;
        importedChapterCount = 0;
        importedPageCount = 0;
        totalChapterCount = pendingChapters.Count;
        currentStatus = "Başlatılıyor...";
        StateHasChanged();

        try
        {
            // Mevcut bölüm numaralarını al
            var existingChapters = await ChapterService.GetChaptersAsync(SeriesId.Value);
            var existingNums = existingChapters.Select(c => c.Number).ToHashSet();

            foreach (var chapter in pendingChapters.OrderBy(c => c.ChapterNumber))
            {
                currentChapterNum = chapter.ChapterNumber;
                
                // Çakışma varsa yeni numara bul
                var chapterNumber = chapter.ChapterNumber;
                while (existingNums.Contains(chapterNumber))
                {
                    chapterNumber++;
                }
                existingNums.Add(chapterNumber);

                currentStatus = $"Bölüm {chapterNumber} oluşturuluyor...";
                StateHasChanged();

                // Bölümü oluştur
                var createCommand = new CreateChapterCommand
                {
                    Number = chapterNumber,
                    Title = null
                };
                var newChapterId = await ChapterService.CreateChapterAsync(SeriesId.Value, createCommand);

                // Sayfaları ekle
                foreach (var page in chapter.Pages.OrderBy(p => p.Order))
                {
                    currentStatus = $"Bölüm {chapterNumber}: Sayfa {page.Order}/{chapter.Pages.Count}";
                    StateHasChanged();

                    using var ms = new MemoryStream(page.Data);
                    var savedPath = await ImageService.SavePageImageAsync(ms, page.FileName, newChapterId);

                    var pageCommand = new AddPageCommand
                    {
                        PageNumber = page.Order,
                        ImagePath = savedPath
                    };
                    await PageService.AddPageAsync(newChapterId, pageCommand);
                    importedPageCount++;
                }

                importedChapterCount++;
                StateHasChanged();
            }

            importState = ImportState.Completed;
            pendingChapters.Clear();

            if (OnImportComplete.HasDelegate)
                await OnImportComplete.InvokeAsync(importedChapterCount);
        }
        catch (Exception ex)
        {
            errorMessage = $"İçe aktarma hatası: {ex.Message}";
            importState = ImportState.Error;
        }
    }

    private void Reset()
    {
        importState = ImportState.Idle;
        pendingChapters.Clear();
        errorMessage = null;
        importedChapterCount = 0;
        importedPageCount = 0;
    }

    private static decimal ExtractNumber(string input)
    {
        var match = System.Text.RegularExpressions.Regex.Match(input, @"(\d+(?:\.\d+)?)");
        if (match.Success && decimal.TryParse(match.Value, System.Globalization.NumberStyles.Any, 
            System.Globalization.CultureInfo.InvariantCulture, out var num))
            return num;
        return 1;
    }

    private static int NaturalCompare(string a, string b)
    {
        int ia = 0, ib = 0;
        while (ia < a.Length && ib < b.Length)
        {
            if (char.IsDigit(a[ia]) && char.IsDigit(b[ib]))
            {
                int numStartA = ia, numStartB = ib;
                while (ia < a.Length && char.IsDigit(a[ia])) ia++;
                while (ib < b.Length && char.IsDigit(b[ib])) ib++;
                
                var numA = long.Parse(a.Substring(numStartA, ia - numStartA));
                var numB = long.Parse(b.Substring(numStartB, ib - numStartB));
                
                if (numA != numB) return numA.CompareTo(numB);
            }
            else
            {
                if (a[ia] != b[ib]) return a[ia].CompareTo(b[ib]);
                ia++; ib++;
            }
        }
        return a.Length.CompareTo(b.Length);
    }

    private class PendingChapter
    {
        public decimal ChapterNumber { get; set; }
        public string FolderName { get; set; } = string.Empty;
        public List<PendingPage> Pages { get; set; } = [];
    }

    private class PendingPage
    {
        public int Order { get; set; }
        public string FileName { get; set; } = string.Empty;
        public byte[] Data { get; set; } = [];
        public string ContentType { get; set; } = string.Empty;
    }
}
