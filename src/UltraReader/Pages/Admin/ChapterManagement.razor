@page "/admin/series/{SeriesId:int}/chapters"
@using UltraReader.Services
@using UltraReader.Services.DTOs
@inject IChapterService ChapterService
@inject ISeriesService SeriesService
@inject NavigationManager Navigation

<PageTitle>Bölüm Yönetimi - UltraReader</PageTitle>

<div class="admin-header">
    <div>
        <h1>Bölüm Yönetimi</h1>
        @if (seriesTitle != null)
        {
            <p class="text-muted">@seriesTitle</p>
        }
    </div>
    <div class="header-actions">
        <a href="/admin/series" class="btn btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Geri
        </a>
        <a href="/admin/series/@SeriesId/chapters/bulk-import" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                <line x1="12" y1="11" x2="12" y2="17"></line>
                <line x1="9" y1="14" x2="15" y2="14"></line>
            </svg>
            Klasörden Ekle
        </a>
        <a href="/admin/series/@SeriesId/chapters/new" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Yeni Bölüm
        </a>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
        <p>Yükleniyor...</p>
    </div>
}
else if (chapters == null || !chapters.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">📖</div>
        <p class="empty-state-title">Henüz bölüm eklenmemiş</p>
        <p>Bu seriye yeni bir bölüm ekleyerek başlayın.</p>
        <a href="/admin/series/@SeriesId/chapters/new" class="btn btn-primary mt-2">Yeni Bölüm Ekle</a>
    </div>
}
else
{
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Bölüm No</th>
                    <th>Başlık</th>
                    <th>Sayfa</th>
                    <th>Oluşturulma</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var chapter in chapters)
                {
                    <tr>
                        <td><strong>@chapter.Number</strong></td>
                        <td>@(chapter.Title ?? "-")</td>
                        <td>@chapter.PageCount</td>
                        <td>@chapter.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (chapter.IsRead)
                            {
                                <span class="status-badge status-completed">Okundu</span>
                            }
                            else
                            {
                                <span class="status-badge status-notstarted">Okunmadı</span>
                            }
                        </td>
                        <td class="actions-cell">
                            <a href="/admin/series/@SeriesId/chapters/@chapter.Id/edit" class="btn btn-sm btn-outline" title="Düzenle">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </a>
                            <a href="/admin/series/@SeriesId/chapters/@chapter.Id/pages" class="btn btn-sm btn-outline" title="Sayfalar">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirm(chapter)" title="Sil">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog IsVisible="@showDeleteConfirm"
               Title="Bölümü Sil"
               Message="@($"Bölüm {chapterToDelete?.Number} silinecek. Bu işlem geri alınamaz ve tüm sayfa verileri de silinecektir.")"
               ConfirmText="Sil"
               CancelText="İptal"
               IsDanger="true"
               OnConfirm="HandleDeleteConfirm"
               OnCancel="HideDeleteConfirm" />

@code {
    [Parameter]
    public int SeriesId { get; set; }

    private List<ChapterListItemDto>? chapters;
    private string? seriesTitle;
    private bool isLoading = true;

    private bool showDeleteConfirm = false;
    private ChapterListItemDto? chapterToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var series = await SeriesService.GetSeriesDetailByIdAsync(SeriesId);
            if (series != null)
            {
                seriesTitle = series.Title;
            }
            chapters = await ChapterService.GetChaptersAsync(SeriesId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowDeleteConfirm(ChapterListItemDto chapter)
    {
        chapterToDelete = chapter;
        showDeleteConfirm = true;
    }

    private void HideDeleteConfirm()
    {
        showDeleteConfirm = false;
        chapterToDelete = null;
    }

    private async Task HandleDeleteConfirm()
    {
        if (chapterToDelete != null)
        {
            await ChapterService.DeleteChapterAsync(chapterToDelete.Id);
            HideDeleteConfirm();
            await LoadDataAsync();
        }
    }
}
